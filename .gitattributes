# 设置行尾符统一为LF
* text=auto eol=lf
# 确保中文文件名正确处理
*.pdf -text
*.mp4 -text
*.jpg -text
*.png -text
# Git LFS (如果使用大文件存储)
*.mp4 filter=lfs diff=lfs merge=lfs -text
模型作业/*.mov filter=lfs diff=lfs merge=lfs -text
模型作业/*.MOV filter=lfs diff=lfs merge=lfs -text
*.pptx filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
*.MOV filter=lfs diff=lfs merge=lfs -text
*.mp4 !text !filter !merge !diff
*.MP4 !text !filter !merge !diff
*.mov !text !filter !merge !diff
*.MOV !text !filter !merge !diff
