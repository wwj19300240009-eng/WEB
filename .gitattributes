# 设置行尾符统一为LF
* text=auto eol=lf
# 确保二进制文件不被当做文本处理
*.pdf -text
*.mp4 -text
*.jpg -text
*.png -text
# Git LFS - 只追踪 pptx（大型演示文稿）
*.pptx filter=lfs diff=lfs merge=lfs -text
*.mp4 !text !filter !merge !diff
*.MP4 !text !filter !merge !diff
*.mov !text !filter !merge !diff
*.MOV !text !filter !merge !diff
